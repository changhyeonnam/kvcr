diff --git a/vllm/v1/kv_offload/tiering/kvcr/shared_tier.py b/vllm/v1/kv_offload/tiering/kvcr/shared_tier.py
new file mode 100644
index 0000000000..39f1a9e616
--- /dev/null
+++ b/vllm/v1/kv_offload/tiering/kvcr/shared_tier.py
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""One KVCR single DRAM tier per engine, shared by its worker and scheduler.
+
+The worker maps the primary tier before the scheduler builds its manager, and
+both must use the pool that one claim gave this process. Whichever side comes
+first creates the tier; the last one to let go closes it.
+"""
+
+import threading
+from collections.abc import Callable
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from vllm.v1.kv_offload.tiering.kvcr.manager import KVCRSecondaryTierManager
+
+_lock = threading.Lock()
+_tiers: dict[str, tuple["KVCRSecondaryTierManager", int]] = {}
+
+
+def acquire(
+    key: str, create: Callable[[], "KVCRSecondaryTierManager"]
+) -> "KVCRSecondaryTierManager":
+    """Return the engine's tier, creating it on first use."""
+    with _lock:
+        entry = _tiers.get(key)
+        if entry is not None:
+            tier, users = entry
+            _tiers[key] = (tier, users + 1)
+            return tier
+        tier = create()
+        tier._registry_key = key
+        _tiers[key] = (tier, 1)
+        return tier
+
+
+def release(key: str) -> None:
+    """Drop one user; the last closes KVCR and so unmaps the pool."""
+    with _lock:
+        tier, users = _tiers[key]
+        if users > 1:
+            _tiers[key] = (tier, users - 1)
+            return
+        del _tiers[key]
+    tier.close()
