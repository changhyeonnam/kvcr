@@ -0,0 +1,432 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""KVCR as a single DRAM tier: the primary tier lives in the KVCR service pool."""
+
+import ctypes
+import mmap
+from collections.abc import Collection, Mapping
+from types import SimpleNamespace
+
+import numpy as np
+import pytest
+
+pytest.importorskip("kvcr")
+
+from kvcr.types import BlockKey, CacheTier, InventoryEvent, QueryStatus
+
+from tests.v1.kv_offload.test_factory import _make_offloading_config
+from tests.v1.kv_offload.tiering.test_kvcr_tier import (
+    RecordingKVCR,
+    _job,
+    _StubControlChannel,
+)
+from vllm.v1.kv_offload.base import (
+    LookupResult,
+    Medium,
+    OffloadKey,
+    ReqContext,
+    ScheduleEndContext,
+)
+from vllm.v1.kv_offload.cpu.shared_offload_region import SharedOffloadRegion
+from vllm.v1.kv_offload.tiering.base import JobResult
+from vllm.v1.kv_offload.tiering.factory import SecondaryTierFactory
+from vllm.v1.kv_offload.tiering.kvcr import manager as kvcr_manager
+from vllm.v1.kv_offload.tiering.kvcr import shared_tier
+from vllm.v1.kv_offload.tiering.kvcr.manager import KVCRSecondaryTierManager
+from vllm.v1.kv_offload.tiering.spec import TieringOffloadingSpec
+
+_CHUNK = mmap.PAGESIZE
+_CHUNKS = 4
+_CTX = ReqContext(req_id="req")
+
+
+class _PoolKVCR(RecordingKVCR):
+    """A KVCR whose claimed pool is real memory and whose slots the caller places."""
+
+    def __init__(
+        self,
+        size: int = _CHUNK * _CHUNKS,
+        recovered: Mapping[BlockKey, list[tuple[str, int]]] | None = None,
+    ) -> None:
+        super().__init__()
+        self.pool = mmap.mmap(-1, size)
+        self.address = ctypes.addressof(ctypes.c_char.from_buffer(self.pool))
+        self.held: dict[BlockKey, list[tuple[str, int]]] = dict(recovered or {})
+        self.blocked: set[BlockKey] = set()
+        self.commits: list[dict[BlockKey, list[tuple[str, int]]]] = []
+        self.closed = 0
+
+    def local_dram_pools(self) -> list[tuple[str, int, int]]:
+        return [("", self.address, len(self.pool))]
+
+    def local_dram_residency(self) -> dict[BlockKey, list[tuple[str, int]]]:
+        return {key: list(slots) for key, slots in self.held.items()}
+
+    def commit_framework_slots(self, blocks) -> None:
+        if any(key in self.held for key in blocks):
+            raise ValueError("local DRAM already holds it")
+        blocks = {key: list(slots) for key, slots in blocks.items()}
+        self.commits.append(blocks)
+        self.held.update(blocks)
+
+    def try_retire_framework_slots(
+        self, keys: Collection[BlockKey]
+    ) -> dict[BlockKey, bool]:
+        results = {}
+        for key in keys:
+            if key not in self.held:
+                raise ValueError("local DRAM does not hold it")
+            results[key] = key not in self.blocked
+            if results[key]:
+                del self.held[key]
+        return results
+
+    def close(self) -> None:
+        self.closed += 1
+
+
+def _install(monkeypatch, kvcr: _PoolKVCR) -> None:
+    def make_kvcr(config, bindings, backend_configs, guard_config):
+        kvcr.config = config
+        kvcr.guard_config = guard_config
+        kvcr.nixl_agent_name = config.nixl_agent_name
+        kvcr.backend_configs = backend_configs
+        kvcr.constructor_bindings = bindings
+        kvcr.inventory_sink = bindings.inventory_sink
+        return kvcr
+
+    def make_control(_bind_host, bind_port, advertise_host):
+        return _StubControlChannel(f"tcp://{advertise_host}:{int(bind_port)}")
+
+    monkeypatch.setattr(kvcr_manager, "KVCR", make_kvcr)
+    monkeypatch.setattr(kvcr_manager, "ZmqPeerControlChannel", make_control)
+
+
+def _tier_config(**overrides) -> dict:
+    config = {
+        "type": "kvcr",
+        "single_dram_tier": True,
+        "router_capabilities": ["router_hint"],
+        "control_host": "127.0.0.1",
+        "control_ports": [7777],
+        "control_advertise_host": "127.0.0.1",
+        "kvcr_service_socket_path": "/tmp/kvcr.sock",
+        "compatibility_digest": "digest",
+    }
+    config.update(overrides)
+    return config
+
+
+def _make_tier(monkeypatch, kvcr: _PoolKVCR, **overrides) -> KVCRSecondaryTierManager:
+    _install(monkeypatch, kvcr)
+    tier = SecondaryTierFactory.create_secondary_tier(
+        tier_config=_tier_config(**overrides),
+        primary_kv_view=None,
+        offloading_spec=SimpleNamespace(
+            num_chunks=_CHUNKS,
+            kv_bytes_per_chunk=_CHUNK,
+            config=SimpleNamespace(
+                parallel=SimpleNamespace(data_parallel_rank_local=None)
+            ),
+            kv_events_config=SimpleNamespace(
+                enable_kv_cache_events=True,
+                self_describing_kv_events=True,
+            ),
+        ),
+    )
+    assert isinstance(tier, KVCRSecondaryTierManager)
+    return tier
+
+
+def _key(name: str) -> OffloadKey:
+    return OffloadKey(name.encode())
+
+
+def _block(name: str) -> BlockKey:
+    return BlockKey(name.encode())
+
+
+def test_the_primary_view_is_the_claimed_pool(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+
+    assert kvcr.config.framework_managed_slots
+    assert kvcr.config.pool_layouts == [("", _CHUNK)]
+    # KVCR addresses the primary chunks through its own pool.
+    assert kvcr.backend_configs.framework_regions == []
+    assert kvcr.backend_configs.local_dram is None
+    assert tier.pool_address == kvcr.address
+    assert tier.block_size_bytes == _CHUNK
+    view = np.asarray(tier._primary_kv_view)
+    assert view.shape == (_CHUNKS, _CHUNK)
+    assert view.ctypes.data == kvcr.address
+
+
+@pytest.mark.parametrize(
+    ("overrides", "message"),
+    [
+        ({"kvcr_service_socket_path": None, "compatibility_digest": None}, "needs"),
+        ({"secondary_g2_slots": 2}, "cannot both"),
+    ],
+)
+def test_a_single_tier_needs_the_service_pool(monkeypatch, overrides, message) -> None:
+    with pytest.raises(ValueError, match=message):
+        _make_tier(monkeypatch, _PoolKVCR(), **overrides)
+
+
+def test_a_pool_smaller_than_the_primary_tier_is_refused(monkeypatch) -> None:
+    kvcr = _PoolKVCR(size=_CHUNK * (_CHUNKS - 1))
+    with pytest.raises(ValueError, match="pool-sizes-gb"):
+        _make_tier(monkeypatch, kvcr)
+    assert kvcr.closed == 1
+
+
+def test_a_cascade_records_chunks_without_copying(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+
+    tier.submit_store(_job(1, _CTX, key=_key("a"), chunk_id=2))
+    tier.submit_store(_job(2, _CTX, key=_key("a"), chunk_id=2))
+
+    assert kvcr.deposit_calls == []
+    assert kvcr.commits == [{_block("a"): [("", 2)]}]
+    assert list(tier.get_finished_jobs()) == [JobResult(1, True), JobResult(2, True)]
+
+
+def test_the_eviction_gate_frees_only_what_kvcr_lets_go(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+    tier.submit_store(_job(1, _CTX, key=_key("held"), chunk_id=0))
+    tier.submit_store(_job(2, _CTX, key=_key("free"), chunk_id=1))
+    kvcr.blocked.add(_block("held"))
+
+    assert tier.retire_chunks([_key("held"), _key("free"), _key("unknown")]) == {
+        _key("held"): False,
+        _key("free"): True,
+        _key("unknown"): True,
+    }
+    assert set(kvcr.held) == {_block("held")}
+
+    kvcr.blocked.clear()
+    assert tier.retire_chunks([_key("held")]) == {_key("held"): True}
+    assert kvcr.held == {}
+
+
+def test_a_promotion_is_recorded_once_its_chunks_land(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+    kvcr.query_status = QueryStatus.FETCHABLE
+
+    assert tier.lookup(_key("remote"), _CTX) is LookupResult.HIT
+    tier.submit_load(_job(3, _CTX, key=_key("remote"), chunk_id=3))
+
+    assert list(tier.get_finished_jobs()) == [JobResult(3, True)]
+    assert kvcr.commits == [{_block("remote"): [("", 3)]}]
+
+
+def test_a_failed_promotion_records_nothing(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+
+    def failing_deliver(blocks, request_id=None):
+        op_handle = kvcr._next_op_handle
+        kvcr._next_op_handle += 1
+        kvcr.complete(op_handle, dict.fromkeys(blocks, False))
+        return op_handle
+
+    kvcr.deliver = failing_deliver
+    tier.submit_load(_job(4, _CTX, key=_key("lost"), chunk_id=1))
+
+    assert [result.success for result in tier.get_finished_jobs()] == [False]
+    assert kvcr.commits == []
+
+
+def test_a_block_already_in_the_pool_is_not_promoted_into_it(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+    kvcr.query_status = QueryStatus.HIT
+
+    assert tier.lookup(_key("local"), _CTX) is LookupResult.MISS
+
+
+def test_recovered_chunks_are_handed_to_the_primary_tier(monkeypatch) -> None:
+    kvcr = _PoolKVCR(recovered={_block("kept"): [("", 1)]})
+    tier = _make_tier(monkeypatch, kvcr)
+
+    assert tier.take_recovered_chunks() == {_key("kept"): 1}
+    assert tier.take_recovered_chunks() == {}
+    # Recovered chunks are KVCR's to release like any recorded one.
+    assert tier.retire_chunks([_key("kept")]) == {_key("kept"): True}
+
+
+def test_a_recovered_chunk_outside_the_primary_tier_is_refused(monkeypatch) -> None:
+    kvcr = _PoolKVCR(recovered={_block("far"): [("", _CHUNKS)]})
+    with pytest.raises(ValueError, match="compatibility_digest"):
+        _make_tier(monkeypatch, kvcr)
+    assert kvcr.closed == 1
+
+
+def test_only_disk_inventory_is_announced_by_the_tier(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+    key = _block("k")
+
+    kvcr.inventory_sink(InventoryEvent((key,), CacheTier.LOCAL_G2, False))
+    kvcr.inventory_sink(InventoryEvent((key,), CacheTier.G3, False))
+
+    assert [(event.keys, event.medium) for event in tier.take_events()] == [
+        ([OffloadKey(bytes(key))], Medium.STORAGE)
+    ]
+
+
+def test_release_all_waits_until_every_chunk_is_let_go(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    tier = _make_tier(monkeypatch, kvcr)
+    tier.submit_store(_job(1, _CTX, key=_key("spilling"), chunk_id=0))
+    kvcr.blocked.add(_block("spilling"))
+    polls = []
+
+    def poll_completed():
+        polls.append(None)
+        kvcr.blocked.clear()  # The spill lands.
+        return []
+
+    kvcr.poll_completed = poll_completed
+    tier.release_all()
+
+    assert kvcr.held == {}
+    assert polls == [None]
+
+
+def test_the_last_user_of_a_shared_tier_closes_it(monkeypatch) -> None:
+    kvcr = _PoolKVCR()
+    created = []
+
+    def create():
+        created.append(_make_tier(monkeypatch, kvcr))
+        return created[-1]
+
+    worker = shared_tier.acquire("engine", create)
+    scheduler = shared_tier.acquire("engine", create)
+
+    assert worker is scheduler and len(created) == 1
+    scheduler.shutdown()
+    assert kvcr.closed == 0
+    shared_tier.release("engine")
+    assert kvcr.closed == 1
+    assert "engine" not in shared_tier._tiers
+
+
+def test_a_borrowed_region_views_the_owners_memory_and_leaves_it() -> None:
+    owner = mmap.mmap(-1, _CHUNK * _CHUNKS)
+    address = ctypes.addressof(ctypes.c_char.from_buffer(owner))
+    released = []
+
+    region = SharedOffloadRegion.borrow(
+        address, _CHUNKS, 0, _CHUNK, _CHUNK, on_cleanup=lambda: released.append(1)
+    )
+    view = region.create_next_worker_view(_CHUNK)
+    view[2].fill_(7)
+    kv_view = region.create_kv_memoryview()
+
+    assert owner[2 * _CHUNK : 3 * _CHUNK] == bytes([7]) * _CHUNK
+    assert np.asarray(kv_view).ctypes.data == address
+    kv_view.release()
+    region.cleanup()
+    region.cleanup()
+    assert released == [1]
+    # The owner's mapping is untouched.
+    owner[0:1] = b"\x01"
+
+
+def test_the_spec_builds_the_primary_tier_in_the_pool(monkeypatch) -> None:
+    kvcr = _PoolKVCR(recovered={_block("kept"): [("", 2)]})
+    _install(monkeypatch, kvcr)
+    spec = TieringOffloadingSpec(
+        _make_offloading_config(
+            spec_name="TieringOffloadingSpec",
+            cpu_bytes_to_use=_CHUNK * _CHUNKS,
+            worker_kv_bytes_per_block=_CHUNK,
+            extra_config={
+                "self_describing_kv_events": True,
+                "secondary_tiers": [_tier_config()],
+            },
+        )
+    )
+    assert spec.num_chunks == _CHUNKS
+
+    manager = spec.get_manager()
+    primary = manager.primary_tier
+    (tier,) = manager.secondary_tiers
+
+    assert spec._shared_tier() is tier
+    shared_tier.release(spec._engine_id)
+    assert np.asarray(primary.get_kv_memoryview()).ctypes.data == kvcr.address
+    # The pool's recovered chunk is a primary hit at its slot.
