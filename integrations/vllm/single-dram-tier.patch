@@ -0,0 +1,207 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""CPUOffloadingManager with an eviction gate: a sharing reader approves reuse."""
+
+import pytest
+
+from tests.v1.kv_offload.cpu.test_manager import (
+    _EMPTY_REQ_CTX,
+    ExpectedPrepareStoreOutput,
+    make_cpu_manager,
+    to_key,
+    to_keys,
+    verify_load_output,
+    verify_store_output,
+)
+from vllm.v1.kv_offload.base import LookupResult, Medium, OffloadingEvent
+from vllm.v1.kv_offload.cpu.manager import CPUOffloadingManager
+
+
+class _Gate:
+    """Hold back the keys in ``blocked``; release everything else."""
+
+    def __init__(self, *blocked: int):
+        self.blocked = set(to_keys(list(blocked)))
+        self.calls: list[list] = []
+        self.released_all = 0
+
+    def __call__(self, keys):
+        self.calls.append(list(keys))
+        return {key: key not in self.blocked for key in keys}
+
+    def release_all(self) -> None:
+        self.released_all += 1
+
+
+def _gated(gate: _Gate, num_chunks: int, policy: str) -> CPUOffloadingManager:
+    manager = make_cpu_manager(
+        num_chunks=num_chunks, cache_policy=policy, enable_events=True
+    )
+    manager.set_eviction_gate(gate, gate.release_all)
+    return manager
+
+
+def _store(manager: CPUOffloadingManager, *int_hashes: int):
+    keys = to_keys(list(int_hashes))
+    output = manager.prepare_store(keys, _EMPTY_REQ_CTX)
+    if output is not None:
+        manager.complete_store(output.keys_to_store, _EMPTY_REQ_CTX)
+    return output
+
+
+def _events(manager: CPUOffloadingManager) -> list[tuple[list, bool]]:
+    return [(event.keys, event.removed) for event in manager.take_events()]
+
+
+@pytest.mark.parametrize("policy", ["lru", "arc"])
+def test_a_held_back_victim_leaves_the_cache_but_keeps_its_slot(policy) -> None:
+    gate = _Gate(1)
+    manager = _gated(gate, 2, policy)
+    _store(manager, 1)
+    _store(manager, 2)
+    _events(manager)
+
+    output = manager.prepare_store(to_keys([3]), _EMPTY_REQ_CTX)
+
+    # Key 1 is held back, so key 2's slot is the one reused.
+    verify_store_output(
+        output,
+        ExpectedPrepareStoreOutput(
+            keys_to_store=[3], store_chunk_ids=[1], evicted_keys=[1, 2]
+        ),
+    )
+    assert gate.calls == [to_keys([1]), to_keys([2])]
+    assert _events(manager) == [(to_keys([1, 2]), True)]
+
+
+@pytest.mark.parametrize("policy", ["lru", "arc"])
+def test_a_held_back_slot_is_freed_once_the_gate_lets_go(policy) -> None:
+    gate = _Gate(1)
+    manager = _gated(gate, 2, policy)
+    _store(manager, 1)
+    _store(manager, 2)
+    _store(manager, 3)
+    gate.blocked.clear()
+    gate.calls.clear()
+
+    output = manager.prepare_store(to_keys([4]), _EMPTY_REQ_CTX)
+
+    # The slot key 1 kept is reused without evicting anything else.
+    verify_store_output(
+        output,
+        ExpectedPrepareStoreOutput(
+            keys_to_store=[4], store_chunk_ids=[0], evicted_keys=[]
+        ),
+    )
+    assert gate.calls == [to_keys([1])]
+
+
+@pytest.mark.parametrize("policy", ["lru", "arc"])
+def test_a_held_back_chunk_is_rescued_by_a_lookup(policy) -> None:
+    gate = _Gate(1)
+    manager = _gated(gate, 2, policy)
+    _store(manager, 1)
+    _store(manager, 2)
+    _store(manager, 3)
+    _events(manager)
+
+    assert manager.lookup(to_key(1), _EMPTY_REQ_CTX) is LookupResult.HIT
+    verify_load_output(manager.prepare_load(to_keys([1]), _EMPTY_REQ_CTX), [0])
+    assert _events(manager) == [(to_keys([1]), False)]
+
+
+@pytest.mark.parametrize("policy", ["lru", "arc"])
+def test_storing_a_held_back_key_rescues_it_instead_of_copying(policy) -> None:
+    gate = _Gate(1)
+    manager = _gated(gate, 2, policy)
+    _store(manager, 1)
+    _store(manager, 2)
+    _store(manager, 3)
+
+    output = manager.prepare_store(to_keys([1]), _EMPTY_REQ_CTX)
+
+    verify_store_output(
+        output,
+        ExpectedPrepareStoreOutput(
+            keys_to_store=[], store_chunk_ids=[], evicted_keys=[]
+        ),
+    )
+    assert manager.lookup(to_key(1), _EMPTY_REQ_CTX) is LookupResult.HIT
+
+
+@pytest.mark.parametrize("policy", ["lru", "arc"])
+def test_a_store_fails_when_the_gate_holds_back_too_much(policy) -> None:
+    gate = _Gate(1, 2)
+    manager = _gated(gate, 2, policy)
+    _store(manager, 1)
+    _store(manager, 2)
+    _events(manager)
+
+    assert manager.prepare_store(to_keys([3]), _EMPTY_REQ_CTX) is None
+
+    # Both left the cache while the gate kept their slots.
+    assert _events(manager) == [(to_keys([1, 2]), True)]
+    assert manager.lookup(to_key(3), _EMPTY_REQ_CTX) is LookupResult.MISS
+    gate.blocked.clear()
+    verify_store_output(
+        manager.prepare_store(to_keys([3]), _EMPTY_REQ_CTX),
+        ExpectedPrepareStoreOutput(
+            keys_to_store=[3], store_chunk_ids=[1], evicted_keys=[]
+        ),
+    )
+
+
+@pytest.mark.parametrize("policy", ["lru", "arc"])
+def test_restored_chunks_are_ready_and_keep_their_slots(policy) -> None:
+    manager = make_cpu_manager(num_chunks=4, cache_policy=policy, enable_events=True)
+
+    manager.restore({to_key(1): 2, to_key(2): 0})
+
+    assert manager.lookup(to_key(1), _EMPTY_REQ_CTX) is LookupResult.HIT
+    verify_load_output(manager.prepare_load(to_keys([2, 1]), _EMPTY_REQ_CTX), [0, 2])
+    manager.complete_load(to_keys([2, 1]), _EMPTY_REQ_CTX)
+    assert list(manager.take_events()) == [
+        OffloadingEvent(keys=to_keys([1, 2]), medium=Medium.CPU, removed=False)
+    ]
+    # New stores take the free slots, lowest first, then evict a restored chunk.
+    verify_store_output(
+        manager.prepare_store(to_keys([3, 4]), _EMPTY_REQ_CTX),
+        ExpectedPrepareStoreOutput(
+            keys_to_store=[3, 4], store_chunk_ids=[1, 3], evicted_keys=[]
+        ),
+    )
+    manager.complete_store(to_keys([3, 4]), _EMPTY_REQ_CTX)
+    output = manager.prepare_store(to_keys([5]), _EMPTY_REQ_CTX)
+    assert output is not None
+    assert len(output.evicted_keys) == 1
+    assert output.evicted_keys[0] in to_keys([1, 2, 3, 4])
+
+
+def test_restoring_nothing_keeps_fresh_allocation() -> None:
+    manager = make_cpu_manager(num_chunks=2)
+    manager.restore({})
+    verify_store_output(
+        manager.prepare_store(to_keys([1]), _EMPTY_REQ_CTX),
+        ExpectedPrepareStoreOutput(
+            keys_to_store=[1], store_chunk_ids=[0], evicted_keys=[]
+        ),
+    )
+
+
+def test_reset_asks_the_gate_to_release_every_slot() -> None:
+    gate = _Gate(1)
+    manager = _gated(gate, 2, "lru")
+    _store(manager, 1)
+    _store(manager, 2)
+    _store(manager, 3)
+
+    manager.reset_cache()
+
+    assert gate.released_all == 1
+    assert manager.lookup(to_key(1), _EMPTY_REQ_CTX) is LookupResult.MISS
+    verify_store_output(
+        manager.prepare_store(to_keys([4, 5]), _EMPTY_REQ_CTX),
+        ExpectedPrepareStoreOutput(
+            keys_to_store=[4, 5], store_chunk_ids=[0, 1], evicted_keys=[]
+        ),
+    )
